# ZAI FLOW 2.0 - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the required values
# NEVER commit the .env file with real credentials to version control

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_ADMIN_KEY=your_admin_key_here
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Use a strong, random secret for JWT signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here_minimum_32_characters

# ============================================================================
# NETLIFY FUNCTIONS
# ============================================================================
# Use a strong API token for Netlify function authentication
# This should be kept secure and rotated periodically
ADMIN_API_TOKEN=your_strong_admin_api_token_here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=production

# ============================================================================
# ALLOWED ORIGINS (CORS)
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGINS=https://zai-digital-studio.com

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - Never commit .env with real values to version control
# - Rotate JWT_SECRET and ADMIN_API_TOKEN periodically
# - Use strong, randomly generated secrets (minimum 32 characters)
# - Keep SUPABASE_ADMIN_KEY secure and never expose in frontend code
# - In production, use environment variables instead of .env file
